
# CampusCompass - Example environment configuration
# Copy this file to .env and add your own credentials.
# Never commit .env to GitHub.

# --- LLM provider ---
# Supported: ollama, groq, xai, openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Cloud LLM credentials
LLM_API_KEY=your-groq-api-key-here
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# --- Optional Tavily web search ---
# Set true only when web search is configured.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=your-tavily-api-key-here
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SECONDS=15

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ChromaDB and document storage ---
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=placement_policy
REGISTRY_PATH=./.chroma/registry.json
UPLOAD_DIR=./uploads

# --- Frontend security ---
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=12
RETRIEVAL_MAX_DISTANCE=0.75
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Admin authentication ---
# Generate a unique token for your local .env.
# Keep empty only if you intentionally disable admin endpoints.
ADMIN_API_TOKEN=replace-with-a-new-random-admin-token
