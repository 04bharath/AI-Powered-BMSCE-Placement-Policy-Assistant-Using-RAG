# Copy to .env and edit. Never commit .env.
# --- LLM provider -------------------------------------------------------
# "ollama" (local, private) or a cloud API: "groq", "xai", "openai_compatible".
# With a cloud provider, student questions and the retrieved policy excerpts are
# sent to that provider. Embeddings and the vector DB always stay local.
LLM_PROVIDER=groq
LLM_MODEL="openai/gpt-oss-20b"


# Only for cloud providers. Put your provider key here, NOT in ADMIN_API_TOKEN.
LLM_API_KEY=your-groq-api-key-here
# Only needed for openai_compatible (groq and xai have built-in URLs).
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Optional: enables web answers for general/current-information questions.
# Get a server-side key from Tavily. Never use a NEXT_PUBLIC_ variable for it.
ENABLE_WEB_SEARCH=True
TAVILY_API_KEY=your-tavily-api-key-here
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=placement_policy
REGISTRY_PATH=./.chroma/registry.json
UPLOAD_DIR=./uploads

# Comma-separated list of exact frontend origins
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=12
# Cosine distance cutoff (lower = stricter). Tune against your own policy document.
RETRIEVAL_MAX_DISTANCE=0.75
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable all admin endpoints.
ADMIN_API_TOKEN=replace-with-a-new-random-admin-token